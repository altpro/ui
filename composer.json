{
    "name": "altpro/ui",
    "description": "HTML + CSS component layer for Tailwind v4, with Blade and Vue components",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0||^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0||^11.0"
    },
    "autoload": {
        "psr-4": {
            "Altpro\\Ui\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Altpro\\Ui\\UiServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
