{
  "name": "@altpro/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HTML + CSS component layer for Tailwind v4, with Blade and Vue components",
  "exports": {
    ".": "./resources/css/ui.css",
    "./js/*": "./resources/js/*",
    "./*": "./resources/css/*"
  },
  "style": "./resources/css/ui.css",
  "files": [
    "resources",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:unit && playwright test",
    "test:unit": "vue-tsc --noEmit && php tests/table-query.php && node --test tests/table-view.ts tests/inventory.test.js",
    "test:a11y": "playwright test a11y.spec.js --project=chromium",
    "test:browsers": "playwright test --project=firefox --project=webkit"
  },
  "peerDependencies": {
    "vue": "^3.5",
    "@inertiajs/vue3": "^3.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "@inertiajs/vue3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@inertiajs/vue3": "^3.8.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.19.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "tailwindcss": "^4.1.0",
    "typescript": "^6.0.3",
    "vite": "^7.0.0",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.12"
  }
}
